# devTools/ is NOT ignored: tools cloned there via getClone.m are detached (.git
# stripped) and meant to be tracked by THIS repo, for deliberate local tool
# development. Empty/absent until a tool is explicitly detached this way; the
# read-only shared clones doIt.m normally runs against live outside this repo,
# under tools/<tool> (see gitClone.m).

# Large intermediary data / doIt.m caches -- regenerated, not version-controlled
*.mat

# Exported figures (regenerable via doIt)
# figures/

# doIt.m run logs
run.log

# bgIsolation worktrees (EnterWorktree scaffold, not repo content)
.claude/worktrees/

# Scratch render dirs and pasted screenshots
tmp_*/
Screenshot*.png

# macOS cruft
.DS_Store

# drawMask.m's manual-ROI cache is the ONE exception to the *.mat rule above -- a
# hand-drawn mask is irreplaceable human effort/judgment, not regenerable, so it MUST be
# version-controlled (see drawMask.m's own CACHING note; mirrors vfMRItools/drawVessel.m's
# drawVesselCache).
!drawMaskCache/*.mat

# scratch/ -- THE canonical place for throwaway agent/dev scratch (probe scripts, run logs, one-off
# verification files). Per Seb 2026-09-05: throwaway scratch belongs INSIDE the repo/worktree so
# that everything related to a change sits in one place, but in a folder git never sees, so that no
# cleanup step is ever needed before committing and no recursive rm is ever required.
#
# The `scratch/*` + `!scratch/.gitkeep` pair is deliberate, not redundant: git cannot track an
# empty directory, so the tracked .gitkeep is what makes scratch/ MATERIALIZE automatically in
# every clone and every future `git worktree add` -- there is no project-initialization step to
# remember and nothing for a new session to create.
scratch/*
!scratch/.gitkeep
# Bare `tmp/` too -- a safety net, not the canonical name. `tmp/` is what an agent reaches for by
# instinct, and a `tmp_*/` rule does NOT match a bare `tmp` (the trailing-underscore glob needs the
# underscore). Ignoring it makes the instinctive slip harmless instead of requiring an rm. The
# canonical name remains scratch/.
tmp/
